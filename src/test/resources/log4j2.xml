<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <Appenders>

        <!-- Consola: muestra INFO y superiores (INFO, WARN, ERROR, FATAL) -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{HH:mm:ss} [%-5level] %logger{1} - %msg%n"/>
        </Console>

        <!-- Archivo: guarda TODO incluyendo DEBUG y TRACE -->
        <File name="File" fileName="test-output/test.log" append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%-5level] %logger{36} - %msg%n"/>
        </File>

    </Appenders>

    <Loggers>

        <!-- Tus clases: nivel DEBUG para ver más detalle -->
        <Logger name="test.api"    level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Logger name="api"         level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>
        <Logger name="util"        level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Logger>

        <!-- Librerías externas: solo WARN para no ensuciar la consola -->
        <Logger name="io.restassured" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
        </Logger>

        <!-- Todo lo demás: INFO -->
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="File"/>
        </Root>

    </Loggers>
</Configuration>